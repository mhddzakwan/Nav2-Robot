<?xml version="1.0"?>
<robot name="robot_mino" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="dark_gray"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="red"><color rgba="1.0 0.0 0.0 1"/></material>

  <!-- ====== UKURAN FISIK — WAJIB DIVALIDASI DENGAN PENGGARIS ASLI ====== -->
  <xacro:property name="wheel_radius" value="0.026"/>       <!-- [CEK] samakan dgn controllers.yaml -->
  <xacro:property name="wheel_separation" value="0.20"/>    <!-- [UKUR ULANG] jarak roda kemungkinan berubah krn plat lebih lebar -->
  <xacro:property name="wheel_width" value="0.02"/>

  <!-- Base sekarang berbentuk SEGI ENAM (hexagon) 24 x 24 cm (bounding box),
       menggantikan bentuk lingkaran sebelumnya. Geometri visual diambil dari
       mesh meshes/base_hexagon.stl (dibuat sesuai referensi foto: sisi depan
       lebih pendek dengan 2 sudut depan dipotong diagonal, sisi belakang
       rata selebar penuh). Collision dibuat sederhana (box) agar ringan
       dihitung Nav2/costmap, dengan bounding box yang sama (24x24 cm). -->
  <xacro:property name="body_length" value="0.24"/>   <!-- depan-belakang (x) -->
  <xacro:property name="body_width" value="0.24"/>    <!-- kiri-kanan (y) -->
  <xacro:property name="base_height" value="0.05"/>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="file:///home/pi/ros2_ws/src/robot_mino_control/mesh/base_hexagon.stl" scale="1 1 1"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <!-- Disederhanakan jadi box (bounding box hexagon) supaya collision-check
           Nav2/costmap tetap ringan; footprint aktual utk Nav2 tetap diatur
           terpisah sbg polygon di nav2_params.yaml. -->
      <geometry><box size="${body_length} ${body_width} ${base_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="1.8"/> <!-- [UKUR ULANG] massa total kemungkinan berubah krn bentuk plat baru -->
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="wheel" params="prefix y_offset">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${y_offset} -${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Roda tetap 2 buah (differential drive) -->
  <xacro:wheel prefix="left"  y_offset="${wheel_separation/2}"/>
  <xacro:wheel prefix="right" y_offset="-${wheel_separation/2}"/>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- Lidar TEPAT DI TENGAH, warna MERAH -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.03" length="0.025"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.03" length="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- x=0 y=0 karena lidar di pusat. z & yaw dikurangi 1.5708 (putar 90 derajat kanan) -->
    <origin xyz="0 0 0.0375" rpy="0 0 3.14159"/>
  </joint>

  <ros2_control name="RobotMinoSystem" type="system">
    <hardware>
      <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
      <param name="joint_commands_topic">/topic_based_joint_commands</param>
      <param name="joint_states_topic">/topic_based_joint_states</param>
      <param name="trigger_joint_command_threshold">-1</param>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
