    <origin rpy="0 0 0" xyz="0 0 0.02"/>
  </joint>
  <!-- Lidar TEPAT DI TENGAH, warna MERAH -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder length="0.025" radius="0.03"/>
      </geometry>
      <material name="red"/>
